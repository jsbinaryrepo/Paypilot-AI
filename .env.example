# SQLite paths are relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
PORT=3001
# Keep loopback locally. Render uses HOST=0.0.0.0.
HOST="127.0.0.1"
# Built local app uses http://127.0.0.1:3001; Vite dev uses 5173.
CLIENT_ORIGIN="http://127.0.0.1:5173"
# Required when CLIENT_ORIGIN is a public Render URL. Set in Render's environment.
DEMO_PASSWORD=""
# Build-time frontend switch for the public no-sign-in browser-only demo.
VITE_PUBLIC_DEMO="false"
# Local-only owner; this is not a login or production authentication mechanism.
LOCAL_USER_EMAIL="owner@example.test"

# Server only. Leave the key blank to keep manual invoice management available.
GEMINI_API_KEY=""
# Set a structured-output-capable model your Google AI project can access.
GEMINI_MODEL="gemini-3-flash-preview"
INVOICE_TIMEZONE="Asia/Kolkata"

# Optional automatic invoice delivery in the protected owner workspace.
# Use a verified sender address from your email provider; never put the key in VITE_*.
RESEND_API_KEY=""
EMAIL_FROM=""

# PayPal REST app credentials from the SAME Sandbox business account.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Sandbox business account merchant ID (not the REST client ID).
PAYPAL_MERCHANT_ID=""
# Optional: ID of the webhook subscription on this REST app.
PAYPAL_WEBHOOK_ID=""
