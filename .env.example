# SQLite paths are relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# Enable only after creating and migrating a hosted Turso database and verifying an email sender.
ACCOUNTS_ENABLED="false"
# Set true on a public deployment without account sign-in; leave false for local owner mode.
PUBLIC_GUEST_ACCESS="false"
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
# Public build-time flag; set true together with ACCOUNTS_ENABLED.
VITE_ACCOUNTS_ENABLED="false"
PORT=3001
# Keep loopback locally. Render uses HOST=0.0.0.0.
HOST="127.0.0.1"
# Built local app uses http://127.0.0.1:3001; Vite dev uses 5173.
CLIENT_ORIGIN="http://127.0.0.1:5173"
# Build-time frontend switch for the browser-only preview.
VITE_PUBLIC_DEMO="false"
# Build-time label for the anonymous server-backed workspace.
VITE_GUEST_MODE="false"
# Local-only owner; this is not a login or production authentication mechanism.
LOCAL_USER_EMAIL="owner@example.test"

# Server only. Leave the key blank to keep manual invoice management available.
GEMINI_API_KEY=""
# Set a structured-output-capable model your Google AI project can access.
GEMINI_MODEL="gemini-3.8-flash"
INVOICE_TIMEZONE="Asia/Kolkata"

# Required for account sign-up and automatic invoice email after confirmation.
# Owner PayPal invoices use PayPal's send API instead.
# Use a verified sender address from your email provider; never put the key in VITE_*.
RESEND_API_KEY=""
EMAIL_FROM=""

# PayPal REST app credentials from the SAME Sandbox business account.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Sandbox business name displayed on PayPal-hosted invoices.
PAYPAL_BUSINESS_NAME=""
# Sandbox business account merchant ID (not the REST client ID).
PAYPAL_MERCHANT_ID=""
# Required for automatic webhook updates; manual status checks work without it.
PAYPAL_WEBHOOK_ID=""
