{
  "name": "paypilot-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev:full",
    "dev:full": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "check:client": "eslint client vite.config.ts && npm run build:client",
    "db:generate": "prisma generate",
    "db:migrate": "tsx server/src/migrate.ts",
    "db:dev": "prisma migrate dev",
    "typecheck": "npm run typecheck:all",
    "typecheck:all": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p client/tsconfig.json",
    "lint": "eslint .",
    "test": "tsx --test --test-concurrency=1 server/src/*.test.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc --noEmit -p client/tsconfig.json && vite build",
    "build": "npm run build:full",
    "build:full": "npm run build:server && npm run build:client",
    "check": "npm run check:full",
    "check:full": "npm run lint && npm run typecheck:all && npm test && npm run build:full",
    "start": "node dist/server/src/index.js"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@prisma/client": "6.19.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^1.70.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0",
      "effect": "^3.20.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "prisma": "6.19.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2"
  }
}
