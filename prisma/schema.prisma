generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  OVERDUE
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum InvoiceDeliveryStatus {
  PENDING
  ACCEPTED
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  passwordHash String?
  verifiedAt DateTime?
  verificationTokenHash String? @unique
  verificationExpiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Invoice {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  clientName     String
  clientEmail    String
  description    String
  details        Json?
  amountMinor    Int
  currency       String
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  version        Int           @default(1)
  clientRequestId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  payments       Payment[]
  checkout       Checkout?
  delivery       InvoiceDelivery?
  paypalInvoiceId String? @unique
  paypalInvoiceNumber String? @unique
  paypalInvoiceState String?
  paypalInvoiceStartedAt DateTime?
  paypalInvoiceBusyUntil DateTime?
  paypalInvoiceSentAt DateTime?
  paypalInvoiceLastError String?
  paypalInvoicePaymentUrl String?

  @@index([userId, createdAt])
  @@index([userId, status, dueDate])
  @@unique([userId, clientRequestId])
}

model InvoiceDelivery {
  id             String                @id @default(cuid())
  invoiceId      String                @unique
  invoice        Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  status         InvoiceDeliveryStatus @default(PENDING)
  idempotencyKey String                @unique
  sender         String
  recipient      String
  subject        String
  body           String
  providerId     String?               @unique
  startedAt      DateTime              @default(now())
  busyUntil      DateTime              @default(now())
  acceptedAt     DateTime?
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountMinor Int
  currency    String
  status      PaymentStatus @default(PENDING)
  method      String        @default("MANUAL")
  reference   String?       @unique
  paypalInvoiceId String?   @unique
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([invoiceId, status])
}

model Checkout {
  id String @id @default(cuid())
  invoiceId String @unique
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  orderId String? @unique
  createKey String @unique
  captureKey String @unique
  createdAt DateTime @default(now())
  busyUntil DateTime @default(now())
}
